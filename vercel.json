{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/Site/",
      "statusCode": 302
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/signup", "destination": "/api" },
    { "source": "/login", "destination": "/api" },
    { "source": "/logout", "destination": "/api" },
    { "source": "/posts", "destination": "/api" },
    { "source": "/posts/:id", "destination": "/api" },
    { "source": "/posts/:id/:action", "destination": "/api" }
  ]
}
