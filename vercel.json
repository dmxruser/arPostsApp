{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/Site/",
      "statusCode": 302
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/signup", "destination": "/api/signup" },
    { "source": "/login", "destination": "/api/login" },
    { "source": "/logout", "destination": "/api/logout" },
    { "source": "/posts", "destination": "/api/posts" },
    { "source": "/posts/:id", "destination": "/api/posts/:id" },
    { "source": "/posts/:id/:action", "destination": "/api/posts/:id/:action" }
  ]
}
